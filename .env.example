# --- Supabase (projet "mercato", eu-west-3) ---
NEXT_PUBLIC_SUPABASE_URL=https://jfqtgphbpogfvofgtnax.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_52_4InDp2lIYj1xVJSGMrQ_If4zg-Z7

# SERVEUR UNIQUEMENT. Contourne RLS : écriture totale sur la base.
# À récupérer dans Supabase > Project Settings > API. Ne jamais committer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sources de données ---
# api-sports.io, plan gratuit : 100 requêtes/jour (reset 00:00 UTC).
API_FOOTBALL_KEY=

# --- Protection du endpoint d'ingestion ---
# Chaîne aléatoire. Le workflow d'ingestion l'envoie en
# `Authorization: Bearer $CRON_SECRET`. À déclarer AUSSI dans les secrets
# GitHub Actions, à l'identique.
CRON_SECRET=

# --- Développement en session Claude Code sur le web uniquement ---
# `fetch` de Node ignore HTTPS_PROXY par défaut (Node >= 22.21), et sort alors
# par une route dont la politique d'egress est plus stricte : les appels
# sortants échouent en 403 « Host not in allowlist ». Ce drapeau lui fait
# emprunter le même proxy que le reste des outils.
# Inutile en local et sur Vercel.
NODE_USE_ENV_PROXY=1

# --- Secrets GitHub Actions ---
# Settings > Secrets and variables > Actions. Trois secrets, deux workflows :
#
#   SUPABASE_URL                (détourage)  https://<ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY   (détourage)  la même que ci-dessus
#   MERCATO_URL                 (ingestion)  URL du déploiement Vercel
#   CRON_SECRET                 (ingestion)  la même que ci-dessus
#
# L'ingestion tourne sur GitHub Actions et non en cron Vercel : le plan Hobby
# plafonne les crons à un par jour et refuse le déploiement au-delà.
